[Unit]
Description=Slate Agentic Task Tracker
Documentation=https://github.com/thisis-gp/slate
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/c/Users/Nova Benefits/slate
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
