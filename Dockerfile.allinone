# ── All-in-One Slate Container ────────────────────────────────────────────────
# Builds: React UI (static) + FastAPI backend + nginx reverse proxy
# Serves everything on a single port (80 internally, mapped to host)
# 
# Usage:
#   docker build -f Dockerfile.allinone -t slate:latest .
#   docker run -d -p 7331:80 -v slate-data:/root/.slate --name slate slate:latest
# ──────────────────────────────────────────────────────────────────────────────

# Stage 1: Build React UI
FROM node:20-alpine AS ui-builder
WORKDIR /ui
COPY packages/ui/package*.json ./
RUN npm ci
COPY packages/ui/ ./
RUN npm run build

# Stage 2: Python environment setup
FROM python:3.11-slim AS python-base
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/core/pyproject.toml ./packages/core/pyproject.toml
RUN uv sync --frozen --no-dev
COPY packages/core/src/ ./packages/core/src/

# Stage 3: Final runtime image
FROM python:3.11-slim

# Install nginx + supervisor
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python app + venv
WORKDIR /app
COPY --from=python-base /app/ ./
COPY --from=python-base /app/.venv/ /app/.venv/
ENV PATH="/app/.venv/bin:$PATH"

# Copy built UI
COPY --from=ui-builder /ui/dist /usr/share/nginx/html

# Copy configs
COPY nginx.allinone.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Slate DB volume
RUN mkdir -p /root/.slate
VOLUME /root/.slate

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
