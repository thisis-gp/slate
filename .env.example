OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# LLM fallback order: Moonshot(Kimi) -> NVIDIA Nemotron -> Gemini. Optional overrides: MOONSHOT_MODEL, NVIDIA_MODEL, GEMINI_MODEL
MOONSHOT_API_KEY=your_moonshot_key_here
NVIDIA_API_KEY=your_nvidia_nim_key_here
GEMINI_API_KEY=your_gemini_key_here
AGENTIC_OS_DB_PATH=~/.agentic-os/db.sqlite
AGENTIC_OS_CONFIG_PATH=.agentic-os/config.yaml

# Scheduler timezone for the daily Jira approval staging (IANA name).
# The container runs in UTC, so set this or syncs fire at the wrong local time.
SLATE_TZ=Asia/Kolkata

# Restrict which Jira projects can be linked/synced/imported (comma-separated).
# Empty = allow any valid key. This org is BX-only.
JIRA_ALLOWED_PREFIXES=BX

# Obsidian vault root for per-Jira docs (one <KEY>.md per issue under <vault>/slate/).
# Per-repo override: .agents/slate.json -> {"vault_path": "..."} wins over this.
SLATE_VAULT_PATH=~/ObsidianVault

# Daily Jira→Slate import staging (off by default). When on, the scheduler fills
# the import-approval queue each day at JIRA_IMPORT_TIME (local SLATE_TZ); it never
# creates tasks on its own — you approve each in the UI/CLI.
JIRA_IMPORT_ENABLED=0
JIRA_IMPORT_TIME=08:30
